{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "base_provenance_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "SUPPORT",
              "CONTEXT"
            ]
          }
        },
        "required": [
          "source_id",
          "role"
        ]
      },
      "description": "Reference order is semantically irrelevant. Each source_id occurs once. Roles are scientifically material and may never be ignored."
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dependency_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "dependency_classification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "content_origin": {
                "type": "string",
                "enum": [
                  "TARGET_SUPPLIED",
                  "SOURCE_SUPPLIED",
                  "BOTH_SUPPLIED",
                  "MAPPING_GENERATED",
                  "ORIGIN_UNCERTAIN"
                ]
              },
              "epistemic_function": {
                "type": "string",
                "enum": [
                  "FACT",
                  "INFERENCE",
                  "CONDITIONAL_RELATION",
                  "OPERATION",
                  "GOVERNANCE_RULE",
                  "LIMIT",
                  "FUNCTION_UNCERTAIN"
                ]
              },
              "assertion_mode": {
                "type": "string",
                "enum": [
                  "REFERENCED_PREMISE",
                  "ASSERTED_COMPONENT"
                ]
              },
              "origin_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_type": {
                      "type": "string",
                      "enum": [
                        "TARGET",
                        "SOURCE_INSTRUMENT"
                      ]
                    }
                  },
                  "required": [
                    "source_id",
                    "source_type"
                  ]
                }
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "content_origin",
              "epistemic_function",
              "assertion_mode",
              "origin_refs",
              "rationale"
            ]
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "GROUNDING_REF",
              "CLAIM_REF",
              "INLINE_OBLIGATION",
              null
            ]
          },
          "claim_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "SUPPORT",
                    "CONTEXT"
                  ]
                }
              },
              "required": [
                "source_id",
                "role"
              ]
            },
            "description": "Reference order is semantically irrelevant. Each source_id occurs once. Roles are scientifically material and may never be ignored."
          },
          "materiality_rationale": {
            "type": "string",
            "minLength": 1
          },
          "resolution_rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "dependency_id",
          "subject",
          "dependency_classification",
          "resolution",
          "claim_ref",
          "provenance_refs",
          "materiality_rationale",
          "resolution_rationale"
        ]
      }
    },
    "closure_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "DEPENDENCY_UNCERTAIN",
        "SPLIT_REQUIRED"
      ]
    },
    "unresolved_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "claim_id",
    "base_provenance_refs",
    "dependencies",
    "closure_status",
    "unresolved_dependencies"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
