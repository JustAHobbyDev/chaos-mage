{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "frozen_role": {
      "type": "string",
      "enum": [
        "SUPPLIED_FACT",
        "SOURCE_FACT",
        "DERIVED_INFERENCE",
        "CONDITIONAL_RELATION",
        "OPERATION",
        "GOVERNANCE_RULE",
        "LIMIT"
      ]
    },
    "contract_id": {
      "type": "string",
      "enum": [
        "TARGET_FIDELITY",
        "SOURCE_FIDELITY",
        "DERIVED_WARRANT",
        "CONDITIONAL_LICENSE",
        "OPERATION_LICENSE",
        "GOVERNANCE_COHERENCE",
        "LIMIT_WARRANT"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "SATISFIED",
        "CONDITIONAL",
        "VIOLATED",
        "UNCERTAIN"
      ]
    },
    "evaluation_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_type": {
            "type": "string",
            "enum": [
              "TARGET",
              "SOURCE_INSTRUMENT",
              "MAPPING"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_type",
          "source_id"
        ]
      }
    },
    "unresolved_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "claim_id",
    "frozen_role",
    "contract_id",
    "verdict",
    "evaluation_provenance",
    "unresolved_conditions",
    "rationale"
  ]
}
