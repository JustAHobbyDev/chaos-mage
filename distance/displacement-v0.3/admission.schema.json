{
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "cohort": {
      "enum": [
        "primary",
        "provisional",
        "holdout"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "enum": [
              "A",
              "B"
            ]
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "designation": {
            "enum": [
              "instantiation",
              "ontology",
              "mixed",
              "uncertain"
            ]
          },
          "compatible": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "family",
          "index",
          "text",
          "designation",
          "compatible",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "applicability_assumption": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "scope": {
              "const": "Assume only that the listed instantiation conditions hold; retain source, mapping, target question and native baseline exactly."
            }
          },
          "required": [
            "conditions",
            "scope"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "case_id",
    "cohort",
    "reason",
    "conditions",
    "applicability_assumption"
  ],
  "additionalProperties": false
}
