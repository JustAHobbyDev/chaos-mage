{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "condition_id",
    "category",
    "rationale",
    "if_execution",
    "if_validity_relevant",
    "uncertainty"
  ],
  "properties": {
    "condition_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "category": {
      "type": "string",
      "enum": [
        "execution_precondition",
        "mechanism_condition",
        "warrant_condition",
        "target_fidelity_condition",
        "mixed",
        "uncertain"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "if_execution": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verification_or_satisfaction_method"
          ],
          "properties": {
            "verification_or_satisfaction_method": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "if_validity_relevant": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "affected_link"
          ],
          "properties": {
            "affected_link": {
              "type": "string",
              "enum": [
                "state_operation_signal",
                "signal_inference",
                "inference_target",
                "multiple"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {
            "const": "execution_precondition"
          }
        }
      },
      "then": {
        "properties": {
          "if_execution": {
            "type": "object"
          },
          "if_validity_relevant": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "enum": [
              "mechanism_condition",
              "warrant_condition",
              "target_fidelity_condition"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "if_execution": {
            "type": "null"
          },
          "if_validity_relevant": {
            "type": "object"
          }
        }
      }
    }
  ]
}
