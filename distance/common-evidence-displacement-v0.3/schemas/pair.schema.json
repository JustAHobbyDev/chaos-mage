{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "mapping_1": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "mapping_2": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "mapping_A": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "mapping_B": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "common_state_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "cohort": {
      "type": "string",
      "enum": [
        "primary",
        "orientation-control"
      ]
    },
    "control_of": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "case_id",
    "target_id",
    "mapping_1",
    "mapping_2",
    "mapping_A",
    "mapping_B",
    "world_id",
    "common_state_sha256",
    "cohort",
    "control_of"
  ],
  "additionalProperties": false
}
