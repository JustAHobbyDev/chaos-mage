{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "component_type": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "object",
            "properties": {
              "refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "enum": [
                        "SUPPORT",
                        "CONTEXT"
                      ]
                    }
                  },
                  "required": [
                    "source_id",
                    "role"
                  ],
                  "additionalProperties": false
                }
              },
              "support_status": {
                "enum": [
                  "SUFFICIENT",
                  "INSUFFICIENT",
                  "UNCERTAIN"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "refs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "component_id",
          "component_type",
          "value",
          "scope",
          "provenance"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "packet_id",
    "components"
  ],
  "additionalProperties": false
}
