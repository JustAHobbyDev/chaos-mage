{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "positive",
        "negative",
        "h4-regressions",
        "h3-regressions"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "component_type": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "object",
            "properties": {
              "refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "enum": [
                        "SUPPORT",
                        "CONTEXT"
                      ]
                    }
                  },
                  "required": [
                    "source_id",
                    "role"
                  ],
                  "additionalProperties": false
                }
              },
              "support_status": {
                "enum": [
                  "SUFFICIENT",
                  "INSUFFICIENT",
                  "UNCERTAIN"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "refs"
            ],
            "additionalProperties": false
          },
          "expected_support_status": {
            "enum": [
              "SUFFICIENT",
              "INSUFFICIENT",
              "UNCERTAIN",
              null
            ]
          },
          "expected_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "component_id",
          "component_type",
          "value",
          "scope",
          "provenance",
          "expected_support_status",
          "expected_codes"
        ],
        "additionalProperties": false
      }
    },
    "expected_mechanical_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "semantic_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_complete_units": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "fixture_id",
    "packet_id",
    "description",
    "category",
    "components",
    "expected_mechanical_codes"
  ],
  "additionalProperties": false
}
