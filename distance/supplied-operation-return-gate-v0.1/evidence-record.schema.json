{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "H6.R4 natural case evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "selection", "routing", "measurements", "overall"],
  "properties": {
    "version": {"const": 1},
    "status": {"enum": ["SCREENED_CANDIDATE", "SELECTED"]},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "slot", "source_experiment", "original_claim_id", "claim_path", "claim_file_sha256", "claim_pointer", "frozen_text", "frozen_scope", "content_origin", "epistemic_function", "assertion_mode", "source_refs", "why_selected", "expected_contracts", "hidden_operator_hypothesis"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "slot": {"enum": ["negative_operation", "positive_operation", "referenced_premise"]},
        "source_experiment": {"type": "string", "minLength": 1},
        "original_claim_id": {"type": "string", "minLength": 1},
        "claim_path": {"type": "string", "minLength": 1},
        "claim_file_sha256": {"$ref": "#/$defs/sha256"},
        "claim_pointer": {"type": "string", "pattern": "^/"},
        "frozen_text": {"type": "string", "minLength": 1},
        "frozen_scope": {"type": "string", "minLength": 1},
        "content_origin": {"enum": ["TARGET_SUPPLIED", "SOURCE_SUPPLIED"]},
        "epistemic_function": {"enum": ["FACT", "INFERENCE", "CONDITIONAL_RELATION", "OPERATION", "GOVERNANCE_RULE", "LIMIT"]},
        "assertion_mode": {"enum": ["ASSERTED_COMPONENT", "REFERENCED_PREMISE"]},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "why_selected": {"type": "string", "minLength": 1},
        "expected_contracts": {"$ref": "#/$defs/contracts"},
        "hidden_operator_hypothesis": {
          "type": "object", "additionalProperties": false,
          "required": ["fidelity_verdict", "operation_verdict", "overall"],
          "properties": {
            "fidelity_verdict": {"$ref": "#/$defs/nullable_verdict"},
            "operation_verdict": {"$ref": "#/$defs/nullable_verdict"},
            "overall": {"$ref": "#/$defs/nullable_verdict"}
          }
        }
      }
    },
    "routing": {
      "type": "object", "additionalProperties": false,
      "required": ["resolution", "contracts", "rationale"],
      "properties": {
        "resolution": {"enum": ["INLINE_OBLIGATION", "GROUNDING_REF"]},
        "contracts": {"$ref": "#/$defs/contracts"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "measurements": {"type": "array", "items": {"$ref": "#/$defs/measurement"}},
    "overall": {"$ref": "#/$defs/nullable_verdict"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_verdict": {"enum": [null, "SATISFIED", "CONDITIONAL", "VIOLATED", "UNCERTAIN"]},
    "contract": {"enum": ["TARGET_FIDELITY", "SOURCE_FIDELITY", "OPERATION_LICENSE"]},
    "contracts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/contract"}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "role", "path", "file_sha256", "pointer", "text", "text_sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["SUPPORT", "CONTEXT"]},
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "pointer": {"type": "string", "pattern": "^/"},
        "text": {"type": "string", "minLength": 1},
        "text_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["obligation_id", "contract", "verdict", "reasoning", "evidence_used", "lineage"],
      "properties": {
        "obligation_id": {"type": "string", "minLength": 1},
        "contract": {"$ref": "#/$defs/contract"},
        "verdict": {"enum": ["SATISFIED", "CONDITIONAL", "VIOLATED", "UNCERTAIN"]},
        "reasoning": {"type": "string", "minLength": 1},
        "evidence_used": {"type": "array", "uniqueItems": true, "items": {
          "type": "object", "additionalProperties": false, "required": ["source_id"],
          "properties": {"source_id": {"type": "string", "minLength": 1}}
        }},
        "lineage": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "execution_commit", "model", "reasoning_effort", "reservation_id", "request", "response", "raw_evidence", "reuse_basis"],
          "properties": {
            "mode": {"enum": ["FRESH", "FROZEN_FIDELITY_REUSE"]},
            "execution_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "model": {"const": "gpt-6-astra"},
            "reasoning_effort": {"const": "high"},
            "reservation_id": {"type": ["string", "null"]},
            "request": {"$ref": "#/$defs/artifact"},
            "response": {"$ref": "#/$defs/artifact"},
            "raw_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
            "reuse_basis": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}
